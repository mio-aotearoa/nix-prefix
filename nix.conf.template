# Nix configuration for Termux
# Location: /data/data/com.termux/files/nix/etc/nix/nix.conf
#
# Environment layout:
#   NIX_PREFIX=/data/data/com.termux/files/nix
#   NIX_STORE_DIR=/data/data/com.termux/files/nix/store
#   NIX_STATE_DIR=/data/data/com.termux/files/nix/var/nix
#   NIX_CONF_DIR=/data/data/com.termux/files/nix/etc/nix
#   NIX_LOG_DIR=/data/data/com.termux/files/nix/var/log/nix

# Single-user mode (no build daemon / nixbld group on Termux)
build-users-group =

# Sandboxing requires unprivileged user/mount namespaces unavailable on Android
sandbox = false

# Enable modern Nix CLI and Flakes (required for flake-based Home Manager)
experimental-features = nix-command flakes

# Build settings
max-jobs = auto
cores = 0

# Custom store prefix cannot use caches with StoreDir=/nix/store directly
# (Note: https://prefix.cachix.org currently uses StoreDir=/nix/store for host/CI builds;
# configure a cache advertising StoreDir=/data/data/com.termux/files/nix/store here if available.)
substituters =
trusted-public-keys =

# Optional: configure a custom binary cache built for /data/data/com.termux/files/nix/store
# substituters = https://your-cache.example.com
# trusted-public-keys = your-cache.example.com:base64encodedkey

# Keep build logs under /data/data/com.termux/files/nix/var/log/nix
keep-build-log = true
keep-failed = false

# Hardlink store optimisation can fail on Android/F2FS/sdcardfs
auto-optimise-store = false

# SSL certificate bundle (populated by install.sh)
# ssl-cert-file = /data/data/com.termux/files/nix/store/<hash>-nss-cacert-.../etc/ssl/certs/ca-bundle.crt
